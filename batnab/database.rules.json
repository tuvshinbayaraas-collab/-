{
  "rules": {
    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": false,
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "settings": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "trial": {".validate": "newData.isString() && newData.val().matches(/^([0-9]{1,2}[AB])?$/)"},
      "retakes": {".validate": "newData.isBoolean()"},
      "$other": {".validate": false}
    },
    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.hasChildren(['username', 'name'])",
        "username": {".validate": "newData.isString() && newData.val().matches(/^[a-z0-9_.-]{3,30}$/)"},
        "name": {".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 60"},
        "nickname": {
          ".write": "auth != null && auth.uid === $uid && data.parent().child('username').exists() && data.parent().child('disabled').val() !== true",
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 30"
        },
        "photo": {
          ".write": "auth != null && auth.uid === $uid && data.parent().child('username').exists() && data.parent().child('disabled').val() !== true",
          ".validate": "newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length <= 60000"
        },
        "createdAt": {".validate": "newData.isNumber()"},
        "disabled": {".validate": "newData.isBoolean()"},
        "$other": {".validate": false}
      }
    },
    "keys": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$testId": {
        ".read": "root.child('settings/trial').val() === $testId || (!root.child('settings/trial').exists() && $testId === '1A') || (auth != null && root.child('results').child(auth.uid).child($testId).exists())",
        ".validate": "$testId.matches(/^[0-9]{1,2}[AB]$/) && newData.isString() && newData.val().matches(/^[A-E-]{1,100}$/)"
      }
    },
    "results": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        "$testId": {
          ".validate": "$testId.matches(/^[0-9]{1,2}[AB]$/)",
          "$resultId": {
            ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.exists() && root.child('users').child($uid).child('username').exists() && root.child('users').child($uid).child('disabled').val() !== true && (root.child('settings/retakes').val() !== false || !root.child('results').child($uid).child($testId).exists())",
            ".validate": "newData.hasChildren(['answers', 'seconds', 'at'])",
            "answers": {".validate": "newData.isString() && newData.val().matches(/^[A-E-]{1,100}$/)"},
            "seconds": {".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 604800"},
            "at": {".validate": "newData.isNumber() && newData.val() <= now"},
            "$other": {".validate": false}
          }
        }
      }
    }
  }
}
